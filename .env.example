# Create a Groq API key at https://console.groq.com/keys and keep it server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE=https://api.groq.com/openai/v1

# Local document and lexical-index locations
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LEXICAL_INDEX_PATH=vector_db/bm25_store

# Optional ingestion and retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=3
RETRIEVAL_TOP_N=2
LLM_TEMPERATURE=0.05
GENERATION_MAX_TOKENS=512
GROUNDING_OVERLAP_THRESHOLD=0.2
RETRIEVAL_CONFIDENCE_THRESHOLD=0.2

# Phrase -> extra search terms used to rewrite queries (edit to suit your corpus)
QUERY_EXPANSIONS_PATH=data/query_expansions.json

# Logging: full prompts/passages are written only when RAG_DEBUG_LOGS=true.
# JSONL logs rotate to <name>.1.jsonl once they reach LOG_MAX_BYTES.
RAG_DEBUG_LOGS=false
LOG_MAX_BYTES=5242880

# Public-demo guards (leave empty for local development)
# PROXY_SECRET: the backend only serves requests carrying it; set the same value as RAG_PROXY_SECRET.
# ADMIN_TOKEN: needed to rebuild the index. The limits cap answers per visitor and per day (0 = off).
PROXY_SECRET=
ADMIN_TOKEN=
QUERY_RATE_LIMIT_PER_MINUTE=0
DAILY_QUERY_LIMIT=0
# Build the search index at startup when it is missing (hosts with a fresh disk on each deploy)
BUILD_INDEX_ON_STARTUP=true

# Dashboard (Next.js server): where the /rag-api proxy forwards requests, and the shared proxy secret
RAG_BACKEND_URL=http://127.0.0.1:8000
RAG_PROXY_SECRET=
